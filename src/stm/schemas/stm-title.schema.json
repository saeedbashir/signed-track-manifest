{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/saeedbashir/signed-track-manifest/schema/0.1/stm-title.schema.json",
  "title": "Signed Track Manifest — per-title manifest",
  "description": "Describes one title: its main programme video, zero or more sign language tracks delivered as separate video layers, and caption tracks. Version 0.1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["stmVersion", "id", "title", "durationMs", "source", "video", "signLanguage", "captions"],
  "properties": {
    "stmVersion": { "const": "0.1" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$",
      "description": "Stable identifier, lower-case, hyphens. Unique within a catalogue."
    },
    "title": { "type": "string", "minLength": 1 },
    "durationMs": { "type": "integer", "minimum": 0 },
    "source": { "$ref": "#/$defs/source" },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": ["main", "poster"],
      "properties": {
        "main": { "$ref": "#/$defs/videoAsset" },
        "poster": { "$ref": "#/$defs/url" }
      }
    },
    "signLanguage": {
      "type": "array",
      "items": { "$ref": "#/$defs/signTrack" }
    },
    "captions": {
      "type": "array",
      "items": { "$ref": "#/$defs/caption" }
    }
  },
  "$defs": {
    "url": {
      "type": "string",
      "minLength": 1,
      "description": "Absolute URL or a path relative to the manifest."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publisher", "url", "licence", "attribution"],
      "properties": {
        "publisher": { "type": "string", "minLength": 1 },
        "url": { "$ref": "#/$defs/url" },
        "licence": {
          "type": "string",
          "minLength": 1,
          "description": "Licence identifier. Recommended values: public-domain-usgov, cc0-1.0, cc-by-4.0, or an SPDX identifier."
        },
        "attribution": { "type": "string", "minLength": 1 },
        "productionCredit": {
          "type": "string",
          "description": "Who actually produced the video, which may differ from the publisher and changes the copyright position."
        },
        "acquisitionRoute": {
          "type": "string",
          "description": "How the file was obtained: agency download, public archive, direct request. Not a platform rip."
        }
      }
    },
    "videoAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "width", "height", "codec"],
      "properties": {
        "url": { "$ref": "#/$defs/url" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "codec": { "type": "string", "enum": ["h264", "hevc", "vp9", "av1"] }
      }
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "w": { "type": "integer", "minimum": 1 },
        "h": { "type": "integer", "minimum": 1 }
      }
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "sourceLayout", "confidence", "cropRect", "fillMethod"],
      "properties": {
        "method": { "type": "string", "enum": ["detected-crop", "manual-crop"] },
        "sourceLayout": { "type": "string", "enum": ["corner-inset", "side-panel"] },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "0..1. Below 0.7 the title should be badged as low confidence by any player."
        },
        "cropRect": {
          "$ref": "#/$defs/rect",
          "description": "The fixed rectangle, in source-frame pixels, that the signer track was cut from."
        },
        "fillMethod": {
          "type": "string",
          "enum": ["none", "interpolated-surround", "blurred-surround"],
          "description": "How the vacated rectangle in the main video was patched. Never generative."
        }
      }
    },
    "signTrack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "languageLabel", "provenance", "track"],
      "properties": {
        "language": {
          "type": "string",
          "pattern": "^[a-z]{3}$",
          "description": "ISO 639-3 code of the signed language: ase for American Sign Language, bfi for British Sign Language."
        },
        "languageLabel": { "type": "string", "minLength": 1 },
        "provenance": {
          "type": "string",
          "enum": ["human-interpreter", "synthesised"],
          "description": "Required, no default. Whether a human produced this signing or a machine did. A synthesised track can never masquerade as a human one."
        },
        "extraction": { "$ref": "#/$defs/extraction" },
        "generatedBy": { "type": "string", "minLength": 1 },
        "track": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "width", "height", "codec", "syncOffsetMs"],
          "properties": {
            "url": { "$ref": "#/$defs/url" },
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 },
            "codec": { "type": "string", "enum": ["h264", "hevc", "vp9", "av1"] },
            "syncOffsetMs": {
              "type": "integer",
              "description": "Positive delays the signer track relative to the main programme; the player applies it, the pipeline never re-encodes for it."
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "provenance": { "const": "human-interpreter" } } },
          "then": {
            "required": ["extraction"],
            "not": { "required": ["generatedBy"] }
          }
        },
        {
          "if": { "properties": { "provenance": { "const": "synthesised" } } },
          "then": {
            "required": ["generatedBy"],
            "not": { "required": ["extraction"] }
          }
        }
      ]
    },
    "caption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "language", "url", "format"],
      "properties": {
        "kind": { "type": "string", "enum": ["verbatim", "simplified"] },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
          "description": "BCP 47 tag of the written language."
        },
        "url": { "$ref": "#/$defs/url" },
        "format": { "type": "string", "enum": ["webvtt"] },
        "generatedBy": {
          "type": "string",
          "minLength": 1,
          "description": "Present when a machine produced the text. Its presence makes reviewed mandatory."
        },
        "reviewed": {
          "type": "boolean",
          "description": "Whether a human has checked this text. Machine-generated tracks are written with false."
        },
        "reviewedBy": {
          "type": "string",
          "minLength": 1,
          "description": "Who reviewed it. Required when reviewed is true."
        }
      },
      "allOf": [
        {
          "if": { "required": ["generatedBy"] },
          "then": { "required": ["reviewed"] }
        },
        {
          "if": { "properties": { "reviewed": { "const": true } }, "required": ["reviewed"] },
          "then": { "required": ["reviewedBy"] }
        },
        {
          "if": { "required": ["reviewedBy"] },
          "then": { "properties": { "reviewed": { "const": true } }, "required": ["reviewed"] }
        }
      ]
    }
  }
}
